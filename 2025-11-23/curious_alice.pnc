v1 << vid "https://upload.wikimedia.org/wikipedia/commons/transcoded/c/ca/Curious_Alice_%281971%29.webm/Curious_Alice_%281971%29.webm.480p.vp9.webm";
v2 << vid "https://upload.wikimedia.org/wikipedia/commons/transcoded/a/af/Alice_in_Wonderland_%281915%29.webm/Alice_in_Wonderland_%281915%29.webm.720p.vp9.webm";

v << v1;
speed << (unipolar $ osc 0.001) * 2;
radius << 0.01 + (unipolar $ osc 0.1) * 0.02;

phaseR << 0;
phaseG << 2*pi/3;
phaseB << 4*pi/3;

st << speed*time;

aR << st + phaseR;
xR << radius * cos aR;
yR << radius * sin aR;

aG << st + phaseG;
xG << radius * cos aG;
yG << radius * sin aG;

aB << st + phaseB;
xB << radius * cos aB;
yB << radius * sin aB;

move [xR, yR] [(rgbr v), 0, 0] >> add; 
move [xG, yG] [0, (rgbg v), 0] >> add; 
move [xB, yB] [0, 0, (rgbg v)] >> add; 

s << slow 8 $ seq [4, 2, 1, 3, 12];
--zoom (3 + (0.5 * (osc 0.1))) $ spin (osc 0.01) $ move [0.5, 0.5] $ tile s (v*0.5) >> mul;

i2 << rgbv (v*0.4) < 0.4;
i3 << sign $ v -: (0.2~~0.3 $ osc [0.13, 0.15, 0.09]);
i2*i3 >> add;

--v2*(0.5 * (osc 0.01)) >> add;

move [0,(unipolar $ tile [2,1] $ osc 0.01)*rgbb v *(rgbb v>rgbr v)] v >> add;dd;dd;dd;dd;dd;dd;dd;dd;dd;dd;dd;dd;dd;